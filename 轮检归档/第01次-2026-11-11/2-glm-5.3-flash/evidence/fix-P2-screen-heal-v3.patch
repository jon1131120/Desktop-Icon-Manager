        // 判据 v3（第01次轮检 R18 修复）：conf 坐标是屏相对坐标，两块物理屏的数值
        //   区间天然重叠，「包围盒相交」会把真第二屏并进主屏（实测外接屏 8 项被误并、
        //   快照污染成 32 项伪单屏）。本质判据：同一物理屏的 screenWidth/screenHeight
        //   相同——合盖重编号只改 screen 号、不改尺寸。尺寸缺失（旧 conf）时退回
        //   「旧组包含于主组」判据（15% 容差，比旧「任意相交」严格）。
        let sameScreen: Bool
        if b.w > 0 && main.w > 0 {
            sameScreen = b.w == main.w && b.h == main.h
        } else {
            let tolX = max(1, Int(Double(main.maxX - main.minX) * 0.15))
            let tolY = max(1, Int(Double(main.maxY - main.minY) * 0.15))
            sameScreen = b.minX >= main.minX - tolX && b.maxX <= main.maxX + tolX
                && b.minY >= main.minY - tolY && b.maxY <= main.maxY + tolY
