    var boxes: [String: (minX: Int, minY: Int, maxX: Int, maxY: Int, count: Int, w: Int, h: Int)] = [:]
    for it in attrs where isDesktopItem(it) {
        guard let x = (it["x"] as? NSNumber)?.intValue,
              let y = (it["y"] as? NSNumber)?.intValue else { continue }
        let sid = (it["screen"].map { "\($0)" }) ?? "1"
        let w0 = (it["screenWidth"] as? NSNumber)?.intValue ?? 0
        let h0 = (it["screenHeight"] as? NSNumber)?.intValue ?? 0
        var b = boxes[sid] ?? (x, y, x, y, 0, w0, h0)
        b.minX = min(b.minX, x); b.minY = min(b.minY, y)
        b.maxX = max(b.maxX, x); b.maxY = max(b.maxY, y)
        b.count += 1
        if b.w == 0 { b.w = w0 }
        if b.h == 0 { b.h = h0 }
        boxes[sid] = b
    }

